  atual="bandeiras"
>
  <main class="f-main" id="app" aria-live="polite">
    <p class="hint">Carregando os preços…</p>
  </main>
  <script>
    import { iniciar } from '../scripts/bandeiras';
    iniciar();
  </script>
</Base>
