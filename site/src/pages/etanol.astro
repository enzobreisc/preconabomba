---
// Etanol ou gasolina?: a razão etanol/gasolina em cada estado e o histórico do estado escolhido.
import Base from '../layouts/Base.astro';
---

<Base
  titulo="Preço na Bomba · Etanol ou gasolina?"
  descricao="Em que estados e cidades o etanol compensa: a razão entre o preço do etanol e o da gasolina, com os dados da ANP."
  atual="etanol"
>
  <main class="f-main" id="app" aria-live="polite">
    <p class="hint">Carregando os preços…</p>
  </main>
  <script>
    import { iniciar } from '../scripts/etanol';
    iniciar();
  </script>
</Base>
