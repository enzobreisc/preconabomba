---
// Moldura comum: cabeçalho com a logo, as abas e a dica (#tip). Cada página entra no <slot />.
import '../styles/global.css';

interface Props {
  titulo: string;
  descricao: string;
  atual: 'panorama' | 'cidade' | 'etanol';
}
const { titulo, descricao, atual } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const abas = [
  { id: 'panorama', nome: 'Panorama', href: base },
  { id: 'cidade', nome: 'Minha cidade', href: `${base}minha-cidade/` },
  { id: 'etanol', nome: 'Etanol ou gasolina?', href: `${base}etanol/` },
  { id: 'bandeiras', nome: 'Bandeiras' },
  { id: 'sobre', nome: 'Sobre os dados' },
];
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
  </head>
  <body>
    <div class="wrap">
      <header class="f-head">
        <a class="lg-wrap" href={base} aria-label="Preço na Bomba, página inicial">
          <svg width="29" height="35" viewBox="0 0 40 48" aria-hidden="true"><defs><clipPath id="gota"><path d="M20 2C20 2 5 19 5 31a15 15 0 0 0 30 0C35 19 20 2 20 2Z"></path></clipPath></defs><path d="M20 2C20 2 5 19 5 31a15 15 0 0 0 30 0C35 19 20 2 20 2Z" fill="#2a78d6"></path><g clip-path="url(#gota)"><path d="M0 29q5-4 10 0t10 0t10 0t10 0V50H0Z" fill="#184f95"></path></g><rect x="11" y="34" width="18" height="3" rx="1.5" fill="#fcfcfb"></rect><circle cx="29.5" cy="40.8" r="3.6" fill="#eb6834" stroke="#fcfcfb" stroke-width="1.6"></circle></svg>
          <span class="wm">Preço <i>na</i> Bomba</span>
        </a>
      </header>
      <nav class="f-nav" aria-label="Seções">
        {abas.map((a) =>
          a.href ? (
            <a href={a.href} data-aba={a.id} aria-current={a.id === atual ? 'page' : undefined}>{a.nome}</a>
          ) : (
            <span title="Em breve">{a.nome}</span>
          ),
        )}
      </nav>
      <slot />
    </div>
    <div id="tip" role="tooltip"></div>
  </body>
</html>
